{
  "name": "college-career-agent-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pwsh -NoProfile -File scripts/bootstrap.ps1",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json",
    "check": "npm run build",
    "doctor": "pwsh -NoProfile -File scripts/doctor.ps1",
    "dev:local": "pwsh -NoProfile -File scripts/start-dev.ps1 -SkipTunnel",
    "start": "tsx watch main.ts",
    "test:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}