{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
    "manifestVersion": "1.30",
    "version": "1.0.14",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Compass Now Prototype Team",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Compass Now (${{APP_NAME_SUFFIX}})",
        "full": "Compass Now"
    },
    "description": {
        "short": "Get personalized education and career guidance from Career Coach.",
        "full": "A Microsoft 365 Copilot experience powered by the live Career Coach MCP tool catalog."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "copilotAgents": {
        "declarativeAgents": [
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "permissions": [
        "identity"
    ],
    "validDomains": []
}